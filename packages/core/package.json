{
  "name": "@wbm/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/render/index.ts",
    "./schema": "./src/db/schema.ts"
  },
  "scripts": {
    "build": "echo 'core wird von den Apps direkt transpiliert'",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@axe-core/playwright": "4.14.0",
    "@wbm/templates": "workspace:*",
    "axe-core": "4.14.0",
    "drizzle-orm": "^0.45.4",
    "html-validate": "^11.17.0",
    "imapflow": "^2.9.1",
    "lighthouse": "^13.5.0",
    "mailparser": "^3.12.4",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "playwright": "1.56.1",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
