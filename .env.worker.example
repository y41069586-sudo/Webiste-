# Nur Vorlage. Als .env.worker mit chmod 600 speichern; niemals committen.
# Vor echtem Start gesonderte Betreiberfreigabe, Backup und Queue-Abnahme.
DATABASE_URL=postgres://ROLE:PASSWORD@SESSION_POOLER_HOST:5432/postgres
QUEUE_DATABASE_URL=postgres://ROLE:PASSWORD@SESSION_POOLER_HOST:5432/postgres
APP_URL=https://seitenwerkworld.netlify.app
DEMO_DOMAIN=seitenwerkworld.netlify.app
TRACK_DOMAIN=seitenwerkworld.netlify.app
PUBLIC_PROTOCOL=https
SESSION_SECRET=
ENCRYPTION_KEY=
DRY_RUN=true
LLM_PROVIDER=mock
LEAD_SOURCE=mock
EMAIL_PROVIDER=mock
PAYMENT_PROVIDER=mock
MAIL_PROVIDER=mock
REGISTRAR_PROVIDER=mock
REGISTRAR_ENV=sandbox
HOSTING_PROVIDER=mock
ALLOW_MOCK_PAYMENT=false
STORAGE_DRIVER=s3
S3_ENDPOINT=https://nfecpmamgrcgnnyulioy.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_BUCKET=seitenwerk-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Erst nach eigener Provider-Abnahme echte Adapter wählen; DRY_RUN alleine verhindert keine E-Mail.
ANTHROPIC_API_KEY=
EMAIL_API_KEY=
RESEND_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
# Tatsächliche Widerspruchsadresse; beim Einmal-Code-Abruf aus der App übernehmen.
OPTOUT_EMAIL=
