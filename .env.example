# =============================================================================
# Website-Brief-Maschine – Umgebungsvariablen
# Kopieren nach .env und ausfüllen. Secrets NIE committen.
# Ohne API-Keys laufen alle Anbieter als Mock (lokal, kostenlos, nichts wird versendet).
# =============================================================================

# --- Basis ---------------------------------------------------------------
NODE_ENV=production
DATABASE_URL=postgres://wbm:CHANGE_ME_DB_PASSWORD@postgres:5432/wbm
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Admin-Dashboard (mit https://)
APP_URL=https://seitenwerk.world
# Hosts ohne Protokoll; dürfen identisch mit dem APP-Host sein
DEMO_DOMAIN=entwurf.seitenwerk.world
TRACK_DOMAIN=seitenwerk.world
# Mind. 32 zufällige Zeichen: openssl rand -base64 48
SESSION_SECRET=
# Optional separater Schlüssel für Verschlüsselung (TOTP-Secrets); Standard: SESSION_SECRET
ENCRYPTION_KEY=
LOG_LEVEL=info

# --- KI (Anthropic) ----------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_CREATIVE=claude-opus-5-5
MODEL_BULK=claude-sonnet-5-5
# Serverseitige Fallbacks bei Modell-Ablehnungen (empfohlen)
LLM_SERVER_FALLBACK=true
# anthropic | mock (Standard: anthropic, wenn ANTHROPIC_API_KEY gesetzt)
LLM_PROVIDER=

# --- Lead-Quellen ------------------------------------------------------------
# google_places | osm | mock (Standard: google_places mit Key, sonst mock)
LEAD_SOURCE=
GOOGLE_PLACES_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Zahlungen (Stripe) ------------------------------------------------------
# stripe | mock (Standard: stripe mit Key, sonst mock)
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Nur Notfall/Test: simulierte Zahlung auch mit NODE_ENV=production erlauben (sonst ist der Checkout ohne Stripe gesperrt)
ALLOW_MOCK_PAYMENT=false

# --- Briefversand -------------------------------------------------------------
# letterxpress (Baustein L3; zuerst LXP_MODE=test, siehe docs/go-live-checkliste.md) | mock | pingen (nur inaktive Alternative)
MAIL_PROVIDER=mock
LXP_USERNAME=
LXP_APIKEY=
# test (nur Postbox, kein Druck, nach 7 Tagen gelöscht) | live (erst nach 3 Testaufträgen und ausdrücklichem OK)
LXP_MODE=test
# Geschätzte Zustellung = Versand + so viele Werktage
DELIVERY_BUSINESS_DAYS=3

# Pingen – inaktive Alternative (nicht weiterentwickelt)
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=
PINGEN_ORGANISATION_ID=
# staging | production
PINGEN_ENV=staging
# Signing Secret des Pingen-Webhooks
PINGEN_WEBHOOK_SECRET=

# --- Domains (INWX) ----------------------------------------------------------
# inwx | mock
REGISTRAR_PROVIDER=inwx
REGISTRAR_USER=
REGISTRAR_PASSWORD=
# sandbox (OT&E, https://api.ote.domrobot.com) | production
REGISTRAR_ENV=sandbox
# Nur falls 2FA im INWX-Konto aktiv ist: Base32-Secret des Authenticators
REGISTRAR_TOTP_SECRET=

# --- Hosting der Kundenseiten ------------------------------------------------
# cloudflare | netlify | mock
HOSTING_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NETLIFY_API_TOKEN=

# --- E-Mail (nur Transaktions-Mails) -----------------------------------------
# resend | postmark | mock
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM="Seitenwerk <hallo@seitenwerk.world>"
# Geheimnis für den Inbound-Webhook (?token=… bzw. Basic-Auth)
EMAIL_INBOUND_SECRET=
# Alternativ IMAP-Polling für eingehende Mails
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
OPTOUT_EMAIL=widerspruch@seitenwerk.world
ADMIN_EMAIL=du@example.de

# --- Datei-Speicher ----------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/storage
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Schalter (Startwerte; im Dashboard änderbar) -----------------------------
# DRY_RUN=true sperrt alle kostenpflichtigen Aktionen – auch gegen das Dashboard.
DRY_RUN=true
AUTO_SEND=false
AUTO_APPROVE_DEMOS=false
AUTO_REPLY=false
FOLLOWUP_ENABLED=false
AUTO_OPTIMIZE=false
USE_RATING_IN_LETTER=false

# --- Lernsystem (Update 2; wirksam ab den Bausteinen L4–L6) --------------------
# Mindestanzahl zugestellter Briefe je Variante, bevor ein Gewinner ausgerufen wird
MIN_LETTERS_PER_ARM=100
# Vorschläge des Lern-Agents ohne Freigabe starten (nur Betreff, Nutzen-Satz, QR-Text)
AUTO_ACTIVATE_VARIANTS=false
# Kostenbremse: Kosten pro Kauf in Cent
MAX_CAC_CENTS=20000
# Brief gilt nach so vielen Tagen ab geschätzter Zustellung als ausgewertet
EVALUATION_WINDOW_DAYS=45

# --- Caddy / TLS -------------------------------------------------------------
ACME_EMAIL=du@example.de
# Host des Dashboards ohne Protokoll (gleich wie APP_URL)
APP_HOST=app.example.de
