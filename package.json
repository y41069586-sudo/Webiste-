{
  "name": "website-brief-maschine",
  "private": true,
  "version": "0.1.0",
  "description": "Demo-Websites für lokale Betriebe ohne Website, Versand per Post-Brief, Kauf per Checkout, automatisches Go-Live.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build && pnpm --filter @wbm/web build && pnpm --filter @wbm/worker build",
    "dev": "pnpm -r --parallel --filter @wbm/web --filter @wbm/worker dev",
    "dev:web": "pnpm --filter @wbm/web dev",
    "dev:worker": "pnpm --filter @wbm/worker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @wbm/web test:e2e",
    "db:generate": "pnpm --filter @wbm/core db:generate",
    "db:migrate": "pnpm --filter @wbm/core db:migrate",
    "admin:create": "pnpm --filter @wbm/core admin:create",
    "css:build": "pnpm --filter @wbm/templates build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
